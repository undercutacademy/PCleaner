<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Silver and black: black title bar, white sidebar, silver-grey canvas, near-black accent. -->
  <SolidColorBrush x:Key="TitleBarBrush"      Color="#1A1C1F"/>
  <SolidColorBrush x:Key="TitleBarTextBrush"  Color="#F2F3F5"/>
  <SolidColorBrush x:Key="SidebarBrush"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarTextBrush"   Color="#4A4F57"/>
  <SolidColorBrush x:Key="NavHoverBrush"      Color="#F1F2F4"/>
  <SolidColorBrush x:Key="NavActiveBrush"     Color="#E6E8EB"/>
  <SolidColorBrush x:Key="NavActiveTextBrush" Color="#111214"/>
  <SolidColorBrush x:Key="BgBrush"            Color="#F4F5F7"/>
  <SolidColorBrush x:Key="SurfaceBrush"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#F1F2F4"/>
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#E6E8EB"/>
  <SolidColorBrush x:Key="BorderBrush"        Color="#DDE0E5"/>
  <SolidColorBrush x:Key="TrackBrush"         Color="#E3E6EA"/>
  <SolidColorBrush x:Key="TextBrush"          Color="#1A1C1F"/>
  <SolidColorBrush x:Key="TextMutedBrush"     Color="#5C626B"/>
  <SolidColorBrush x:Key="TextFaintBrush"     Color="#959BA5"/>
  <SolidColorBrush x:Key="AccentBrush"        Color="#1F2226"/>
  <SolidColorBrush x:Key="AccentHoverBrush"   Color="#33373D"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#0E1013"/>
  <SolidColorBrush x:Key="AccentSoftBrush"    Color="#E6E8EB"/>
  <SolidColorBrush x:Key="OnAccentBrush"      Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SuccessBrush"       Color="#2F8B2C"/>
  <SolidColorBrush x:Key="SuccessSoftBrush"   Color="#E6F4E5"/>
  <SolidColorBrush x:Key="WarnBrush"          Color="#D66A00"/>
  <SolidColorBrush x:Key="WarnSoftBrush"      Color="#FFF1E3"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="#D32F2F"/>
  <SolidColorBrush x:Key="HighlightBrush"     Color="#1F2226"/>
  <SolidColorBrush x:Key="LogBgBrush"         Color="#FFFFFF"/>
  <Color x:Key="RingGlowColor">#9AA1AB</Color>
</ResourceDictionary>
