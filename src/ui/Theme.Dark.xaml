<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Black and silver. Layout follows CCleaner; colours do not. -->
  <SolidColorBrush x:Key="TitleBarBrush"      Color="#0B0C0E"/>
  <SolidColorBrush x:Key="TitleBarTextBrush"  Color="#F2F3F5"/>
  <SolidColorBrush x:Key="SidebarBrush"       Color="#0B0C0E"/>
  <SolidColorBrush x:Key="SidebarTextBrush"   Color="#C3C8D0"/>
  <SolidColorBrush x:Key="NavHoverBrush"      Color="#16181B"/>
  <SolidColorBrush x:Key="NavActiveBrush"     Color="#24272C"/>
  <SolidColorBrush x:Key="NavActiveTextBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BgBrush"            Color="#141517"/>
  <SolidColorBrush x:Key="SurfaceBrush"       Color="#1C1E22"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="#26292E"/>
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="#30343A"/>
  <SolidColorBrush x:Key="BorderBrush"        Color="#2A2E34"/>
  <SolidColorBrush x:Key="TrackBrush"         Color="#26292E"/>
  <SolidColorBrush x:Key="TextBrush"          Color="#F2F3F5"/>
  <SolidColorBrush x:Key="TextMutedBrush"     Color="#AEB4BD"/>
  <SolidColorBrush x:Key="TextFaintBrush"     Color="#767D88"/>
  <SolidColorBrush x:Key="AccentBrush"        Color="#D6DAE0"/>
  <SolidColorBrush x:Key="AccentHoverBrush"   Color="#E8EBEF"/>
  <SolidColorBrush x:Key="AccentPressedBrush" Color="#BFC5CD"/>
  <SolidColorBrush x:Key="AccentSoftBrush"    Color="#2C3036"/>
  <SolidColorBrush x:Key="OnAccentBrush"      Color="#0E1013"/>
  <SolidColorBrush x:Key="SuccessBrush"       Color="#5CC25A"/>
  <SolidColorBrush x:Key="SuccessSoftBrush"   Color="#1F3A2B"/>
  <SolidColorBrush x:Key="WarnBrush"          Color="#E8923F"/>
  <SolidColorBrush x:Key="WarnSoftBrush"      Color="#3F2E22"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="#E25C47"/>
  <SolidColorBrush x:Key="HighlightBrush"     Color="#D6DAE0"/>
  <SolidColorBrush x:Key="LogBgBrush"         Color="#0F1012"/>
  <Color x:Key="RingGlowColor">#C9CED6</Color>
</ResourceDictionary>
